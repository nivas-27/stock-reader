# Copy to .env and fill in. .env is gitignored — keep real keys out of the repo.

# Twelve Data: prices, trend and symbol search for the watchlists page.
# Free tier allows 8 requests a minute, which the worker respects.
TWELVE_DATA_API_KEY=

# MongoDB. Both are optional; these are the defaults the code falls back to.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nivas_stock_reader

# HTTP port. Optional, defaults to 8080.
PORT=8080

# Kite / Zerodha: the Indian-stock (NSE) code is still in the repo but is not
# routed in main.go, so these can stay empty.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REQUEST_TOKEN=
KITE_ACCESS_TOKEN=
KITE_PUBLIC_TOKEN=
